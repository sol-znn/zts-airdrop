# zts-airdrop configuration.
#
# Copy to .env. Every flag has an environment name: ZTS_AIRDROP_ + the flag in
# upper case with dashes as underscores, so -min-holding is
# ZTS_AIRDROP_MIN_HOLDING. Anything already set in the real environment wins
# over this file, and an explicit command-line flag wins over both.

# --- node ---
ZTS_AIRDROP_NODE=http://localhost:35997

# --- what to send ---
# ZTS_AIRDROP_ZTS=zts1znnxxxxxxxxxxxxx9z4ulx
# Amount per recipient, in whole token units. The token's own decimals are
# read from the node, so write what a person would say: 10, not 1000000000.
# ZTS_AIRDROP_AMOUNT=10

# --- what to scan ---
# Either a start height...
# ZTS_AIRDROP_FROM=1000000
# ...or a count of momentums back from the tip. ~8640 is a day at 10s.
ZTS_AIRDROP_LAST=8640
# ZTS_AIRDROP_TO=

# --- who counts ---
# Count addresses that only received, not just those that authored a block.
# Slower: it needs full block bodies rather than momentum headers.
# ZTS_AIRDROP_INCLUDE_RECIPIENTS=true
# Skip addresses not already holding this much of the token.
# ZTS_AIRDROP_MIN_HOLDING=1

# --- the key ---
# Pick exactly one. Never put a phrase on the command line: arguments land in
# shell history and in the process table, where any local user can read them.
#
# The devnet phrase, chain 69 only — public by design and worthless elsewhere.
# ZTS_AIRDROP_DEVNET=true
#
# ZTS_AIRDROP_MNEMONIC="word word word ..."
# ZTS_AIRDROP_MNEMONIC_FILE=phrase.txt
# ZTS_AIRDROP_KEYSTORE=wallet.json
# ZTS_AIRDROP_PASSWORD=
ZTS_AIRDROP_INDEX=0

# --- how to run ---
# Left unset, the run is a dry run: it scans, prices the airdrop and prints
# the recipient list without publishing anything. Setting this to true here
# rather than passing -confirm deliberately is not recommended.
# ZTS_AIRDROP_CONFIRM=true
ZTS_AIRDROP_JOURNAL=airdrop-journal.jsonl
# Where scan logs go. Written every run, named by UTC timestamp and range, and
# reproducible: the range inside is always resolved absolute heights, never
# the -last count that drifts. Set empty to disable.
ZTS_AIRDROP_SCAN_LOG_DIR=scans
# Pause between sends, for a public node that rate-limits.
# ZTS_AIRDROP_DELAY=200ms
# ZTS_AIRDROP_STOP_AFTER_ERRORS=10
